.env
.verify-logs/
verify-report.txt
# Everything the agent's browser writes there - screenshots, and also the console
# logs (.log) and page snapshots (.yml) Playwright MCP saves alongside them.
screenshots/*
!screenshots/.gitkeep
node_modules/
.DS_Store

# The application attendees work on, cloned from its own repository by
# ./verify-setup.sh. It is deliberately NOT tracked here and deliberately not a
# submodule: the whole point of the two-repo split is that the app's history
# moves independently of this one, so there must be no recorded commit pointer
# in this tree. See checkpoints/README.md.
app/
