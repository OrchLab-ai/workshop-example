# Copy this file to .env and fill in ONE credential.
#
#   cp .env.example .env
#
# Option A - Claude subscription (most people). Run this on your own machine:
#
#   claude setup-token
#
# It prints a token. Paste it below, uncomment the line, and you are done.
CLAUDE_CODE_OAUTH_TOKEN=

# Option B - API key from https://console.anthropic.com instead.
# ANTHROPIC_API_KEY=

# Only change this if ./verify.sh tells you port 8080 is already in use.
# VERIFY_PORT=8080
